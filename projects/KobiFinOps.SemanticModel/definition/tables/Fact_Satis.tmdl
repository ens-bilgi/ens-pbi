		lineageTag: 80b33234-b93f-47ce-b667-3b6cbcb102cb
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = Automatic

	column CustomerKey
		dataType: string
		lineageTag: 5173691b-301e-499a-9de5-57ce175e1f0b
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	column ChannelKey
		dataType: string
		lineageTag: 1bb339ee-c2f7-43eb-926f-e2ec1afc0c9d
		summarizeBy: none
		sourceColumn: ChannelKey

		annotation SummarizationSetBy = Automatic

